# Copy to .env and fill in. Only GEMINI_API_KEY and GOOGLE_MAPS_API_KEY are needed for the full experience;
# the app starts without any keys (basic records, no 3D).

# --- Google Gemini (records with citations, memory transcription, news triage, AI hypotheses)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
USE_SEARCH_GROUNDING=true

# --- Google Maps Platform: Map Tiles API (Photorealistic 3D Tiles).
# This key is sent to the browser: restrict it to your domain (HTTP referrers) and to the Map Tiles API.
GOOGLE_MAPS_API_KEY=

# --- Optional open data
EUROPEANA_API_KEY=
SKETCHFAB_ENABLED=true
# google_news (personal, non-commercial use only) | gdelt | none
NEWS_PROVIDER=google_news

# --- Curator area (/admin). Leave empty to disable it.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Abuse protection
PUBLIC_GENERATION=true
GENERATION_RATE_PER_HOUR=5
CONTRIBUTION_RATE_PER_HOUR=20
# Set to true only behind a reverse proxy that overwrites X-Forwarded-For
TRUST_PROXY_HEADERS=false

# --- Storage and uploads
# DATA_DIR=./data
MAX_PHOTO_MB=15
MAX_AUDIO_MB=20
MAX_SCAN_MB=300
SEED_DEMO=true
